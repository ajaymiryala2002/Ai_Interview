generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organizer {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  org_name      String?
  candidates    Candidate[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Candidate {
  id             String    @id @default(uuid())
  organizer_id   String
  organizer      Organizer @relation(fields: [organizer_id], references: [id])
  name           String
  email          String
  phone          String?
  role           String    @default("General") // Python, Java, Data Science, etc.
  image_url      String?   // Uploaded candidate photo for face verification
  access_granted Boolean   @default(false)
  inviteTokens   InviteToken[]
  sessions       InterviewSession[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model InviteToken {
  id           String    @id @default(uuid())
  candidate_id String
  candidate    Candidate @relation(fields: [candidate_id], references: [id])
  token        String    @unique
  status       String    @default("pending") // pending, used, expired
  expires_at   DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model InterviewSession {
  id             String    @id @default(uuid())
  candidate_id   String
  candidate      Candidate @relation(fields: [candidate_id], references: [id])
  status         String    @default("invited") // invited, in-progress, completed, rejected, cancelled
  started_at     DateTime?
  ended_at       DateTime?
  overall_score  Float?
  result         String?   // selected, rejected
  rejection_reason String?
  rejection_proofs String? // JSON array of snapshot URLs
  face_verified  Boolean   @default(false)
  face_match_score Float?
  result_email_sent_at DateTime?
  recording_url  String?
  correct_count  Int       @default(0)
  total_answered Int       @default(0)
  cheating_detected Boolean @default(false)
  cheating_reason String?
  answers        Answer[]
  proctorEvents  ProctoringEvent[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Question {
  id         String   @id @default(uuid())
  text       String
  topic      String
  role       String   @default("General") // Python, Java, Data Science, General
  difficulty String   // Easy, Medium, Hard
  type       String   @default("theoretical") // theoretical, problem_solving
  rubric     String
  answers    Answer[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Answer {
  id               String           @id @default(uuid())
  session_id       String
  session          InterviewSession @relation(fields: [session_id], references: [id])
  question_id      String
  question         Question         @relation(fields: [question_id], references: [id])
  answer_text      String?
  answer_audio_url String?
  ai_score         Float?
  ai_feedback      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProctoringEvent {
  id                   String           @id @default(uuid())
  session_id           String
  session              InterviewSession @relation(fields: [session_id], references: [id])
  event_type           String
  timestamp_in_session Int              // seconds from start
  snapshot_url         String?
  createdAt            DateTime         @default(now())
}
